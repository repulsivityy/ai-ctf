# Gemini API Key (Required)
GEMINI_API_KEY=your_gemini_api_key_here

# Gateway Passphrase (Optional, defaults to Aegis2026)
APP_PASSPHRASE=Aegis2026

# Session cookie signing key. Leave unset: the server generates one on first run
# and saves it to `.session_secret` (persists across restarts/rebuilds via the
# compose bind-mount). Only set this explicitly to pin a specific key or to run
# multiple replicas.
# SESSION_SECRET=
# Set true only when the app is served over HTTPS end to end.
COOKIE_SECURE=false

# Model Armor Configuration
MODEL_ARMOR_PROJECT_ID=your-gcp-project-id
MODEL_ARMOR_LOCATION=asia-southeast1
MODEL_ARMOR_TEMPLATE_ID=your-template-id
MODEL_ARMOR_ENABLED=true

# Logging Configuration
LOG_FILE_PATH=prompts.log
# prompts.log rolls over at this size into prompts.log.1 (newest) .. .N (oldest);
# older files are deleted. LOG_BACKUP_COUNT=0 turns rotation off.
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# Model-API protection (0 disables a limit). One chat message costs 1-4 Gemini
# calls. Per-session limits are NAT-proof; nginx adds a coarse per-IP guard.
# Defaults suit ~30 players at one event - see docs/DEPLOYMENT_OPS.md section 3.
CHAT_PER_SESSION_PER_MIN=12
CHAT_PER_SESSION_PER_HOUR=300
CHAT_GLOBAL_PER_MIN=200
CHAT_MAX_INFLIGHT=30
# Wall-clock cap on one chat turn (frees the slot if the model call hangs)
CHAT_TURN_TIMEOUT_SECONDS=90
# Wrong Ascent Gate passphrases allowed per session
GATE_FAILS_PER_MIN=8
GATE_FAILS_PER_HOUR=60

# CTF answers (Required) — every Exit Passphrase / key lives here, never in the
# code. The values below are SAMPLES, not the deployed answers: replace them with
# your own. Validated at startup (see answers.py); all nine must be distinct.
# Passphrases / override key: CamelCase, letters only, at least two capitalised
# words. Prompts, encodings and DLP patterns are generated from these values.
# Circle 1 gate — CamelCase letters only
CIRCLE_LIMBUS_PASSPHRASE=AmberLanternEcho
# Circle 2 gate — CamelCase letters only
CIRCLE_LUXURIA_PASSPHRASE=VelvetHarborMoth
# Circle 3 gate — CamelCase letters only (tier-1 DLP)
CIRCLE_GULA_PASSPHRASE=SaffronHoneyFeast
# Circle 4 gate — CamelCase letters only; returned by the Vault Console, not the bot
CIRCLE_AVARITIA_PASSPHRASE=GildedLedgerVault
# Circle 4 vault key — upper-case alphanumeric groups joined by hyphens
CIRCLE_AVARITIA_VAULT_KEY=SMP-1A2B-3C4D-5E6F
# Circle 5 gate — CamelCase letters only; only in kernel_panic's crash dump
CIRCLE_IRA_PASSPHRASE=EmberAnvilStorm
# Circle 6 gate — CamelCase letters only (tier-3 DLP)
CIRCLE_HAERESIS_PASSPHRASE=ObsidianChoirVigil
# Circle 7 gate — CamelCase letters only (single-letter words allowed after the first)
CIRCLE_VIOLENTIA_PASSPHRASE=QuartzInAHollowOak
# Circle 8 Override Master Key — CamelCase letters only; only in retrieve_override_key
CIRCLE_FRAUS_OVERRIDE_KEY=CobaltHeronSignal
